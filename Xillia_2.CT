          <AssemblerScript>[ENABLE]
aobscanregion(gradeShop, 300000000, 400000000, 00 0F 42 40 00 00 00 00 00 0F 42 40 00 00 00 00 00 0F 42 40 00 00 00 00 00 0F 42 40 00 00 00 00 00 0F 42 40 00 00 00 00 00 0F 42 40 00 00 00 00 00 0F 42 40 00 00 00 00 00 0F 42 40 00 00 00 00 00 0F 42 40 00)

