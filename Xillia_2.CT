            <CheatEntry>
              <ID>63479</ID>
              <Description>"Milla Version"</Description>
              <Options moHideChildren="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>63487</ID>
                  <Description>"READ THIS"</Description>
                  <Color>0000FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>/*
This only changes her portrait in the menus. If you want to change her voice,
you can do so in the "Unlocks" section with "World Map version".
0-5 is Fractured Milla, while everything else (6-F) is Maxwell Milla.
Do note that this also changes your World Map's traveling ability.
*/
[ENABLE]
[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>63467</ID>
                  <Description>"Portrait"</Description>
                  <DropDownList DisplayValueAsItem="1">80:Maxwell Milla
E0:Fractured Milla
</DropDownList>
                  <ShowAsHex>1</ShowAsHex>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>Array of byte</VariableType>
                  <ByteLength>1</ByteLength>
                  <Address>regionCheckFlags+CB</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>83448</ID>
              <Description>"Difficulty Finder"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanregion(Difficulty, 300000000, 400000000, 53 54 52 5F 44 4F 57 4E 4C 4F 41 44 43 4F 4E 54 45 4E 54 53 5F 49 54 45 4D 5F 44 41 54 41 00 03) // should be unique

registersymbol(Difficulty)
[DISABLE]
unregistersymbol(Difficulty)
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>83449</ID>
                  <Description>"READ THIS"</Description>
                  <Color>0000FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>/*
Opening the Options menu resets the Difficulty if it's set on "Unused".

The "Unused" difficulty can corrupt your game due to broken EXP scaling.
It also sets Victor's AI to Easy.
*/
[ENABLE]
[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>83450</ID>
                  <Description>"Difficulty"</Description>
                  <DropDownList DisplayValueAsItem="1">0:Easy
1:Normal
2:Moderate
3:Hard
4:Unknown
5:Unused
</DropDownList>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>Custom</VariableType>
                  <CustomType>4 Byte Big Endian</CustomType>
                  <Address>Difficulty+5C</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
