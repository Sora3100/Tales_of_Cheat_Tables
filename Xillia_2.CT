            <CheatEntry>
              <ID>62699</ID>
              <Description>"Jude -&gt; Wingul Mystic Arte POC"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
AoB = AOBScan("04 27 ? ? ? ? ? 00 00 00 ? ? 47 04 FF 58 36")
if (AoB) then
   lngt = AoB.getCount()
   for i = 0,lngt-1
       do
         writeBytes(AoB[i], 0x03, 0x8D)
         --writeBytes(AoB[i]+11, 0x00, 0x00)
       end
AoB.Destroy()
AoB = nil
end
{$asm}
[DISABLE]
{$lua}
AoB = AOBScan("00 00 ? ? ? ? ? 00 00 00 ? ? 47 04 FF 58 36")
if (AoB) then
   lngt = AoB.getCount()
   for i = 0,lngt-1
       do
         writeBytes(AoB[i], 0x04, 0x27) --Final Fury
        -- writeBytes(AoB[i]+11, 0x07, 0x01) --Meteor Storm
       end
AoB.Destroy()
AoB = nil
end
</AssemblerScript>
