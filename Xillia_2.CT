ctrlScheme+D0:  //Main 1
dd 01

ctrlScheme+D0+4: //Main 2
dd 02

ctrlScheme+D0+100:
dd 01

ctrlScheme+D0+104:
dd 02

ctrlScheme+D0+200:
dd 01

ctrlScheme+D0+204:
dd 02

ctrlScheme+D0+300:
dd 01

ctrlScheme+D0+304:
dd 02

