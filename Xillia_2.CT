[ENABLE]

aobscan(LinkControl,0F 38 F1 94 18 A0 53 00 00 48 8D 90 88 6E 00 00) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

newmem:
  push rcx
  push rsi
  cmp [rax+rbx],1 //This address decides whether you are an enemy or a player
  je partyMember
code:
  movbe [rax+rbx+000053A0],edx
  pop rsi
  pop rcx
  lea rdx,[rax+00006E88]
  jmp return

partyMember:
  //check if party member, then move to approporiate slot
  //party slot 1
  mov rsi,regionCheckEquip-204
  mov rsi,[rsi]
  //link id
  mov rcx,rax
  add rcx,rbx
  add rcx,08
  mov rcx,[rcx]
  cmp esi,ecx
  je slot1
  //party slot 2
  mov rsi,regionCheckEquip-200
  mov rsi,[rsi]
  //link id
  mov rcx,rax
  add rcx,rbx
  add rcx,08
  mov rcx,[rcx]
  cmp esi,ecx
  je slot2
  //party slot 3
  mov rsi,regionCheckEquip-1FC
  mov rsi,[rsi]
  //link id
  mov rcx,rax
  add rcx,rbx
  add rcx,08
  mov rcx,[rcx]
  cmp esi,ecx
  je slot3
  //party slot 4
  mov rsi,regionCheckEquip-1F8
  mov rsi,[rsi]
  //link id
  mov rcx,rax
  add rcx,rbx
  add rcx,08
  mov rcx,[rcx]
  cmp esi,ecx
  je slot4
  jmp code

slot1:
  mov rsi,ctrlChar1
  mov rsi,[rsi]
  cmp [rsi],0
  je code
  mov edx,1
  jmp code

slot2:
  mov rsi,ctrlChar2
  mov rsi,[rsi]
  cmp [rsi],0
  je code
  mov edx,1
  jmp code

slot3:
  mov rsi,ctrlChar3
  mov rsi,[rsi]
  cmp [rsi],0
  je code
  mov edx,1
  jmp code

slot4:
  mov rsi,ctrlChar4
  mov rsi,[rsi]
  cmp [rsi],0
  je code
  mov edx,1
  jmp code

LinkControl:
  jmp newmem
  nop
  nop

return:
registersymbol(LinkControl)

[DISABLE]

LinkControl:
  db 0F 38 F1 94 18 A0 53 00 00 48 8D 90 88 6E 00 00

unregistersymbol(LinkControl)
dealloc(newmem)
