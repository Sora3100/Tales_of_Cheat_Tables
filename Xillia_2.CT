            <CheatEntry>
              <ID>83436</ID>
              <Description>"Force Enable OVL"</Description>
              <Options moHideChildren="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>83437</ID>
                  <Description>"This will also set the OVL Gauge to the max!"</Description>
                  <Color>0000FF</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>83438</ID>
                  <Description>"Disabling scripts will have no effect."</Description>
                  <Color>0000FF</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>83439</ID>
                  <Description>"Jude"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
//OVL Bar Gauge
OverlimitGauge-2B8:
db 44 7A 00 00

//OVL Bar State
OverlimitGauge-2B4:
db 00 00 00 03

//Character
{$lua}
local Address = getAddress("regionCheckEquip") + 0x6DBC + 0x3
local BitLength = 1
local BitStart = 3
local NewValue = 1
writeInteger(Address,readInteger(Address) &amp; (~(((1&lt;&lt;BitLength)-1) &lt;&lt; BitStart)) | ((NewValue &amp; ((1&lt;&lt;BitLength)-1)) &lt;&lt; BitStart))
{$asm}
[DISABLE]
</AssemblerScript>
