[ENABLE]

aobscan(controlModes,0F 38 F0 54 1A 08 48 89 55 30 89 8D 74 04 00 00 48 83 C4 28 48 FF E0 BA C0) // should be unique
alloc(newmem,$1000)

alloc(ctrlModes,$1000)
registersymbol(ctrlModes)
define(ctrlChar1,ctrlModes)
registersymbol(ctrlChar1)
define(ctrlChar2,ctrlModes+8)
registersymbol(ctrlChar2)
define(ctrlChar3,ctrlModes+10)
registersymbol(ctrlChar3)
define(ctrlChar4,ctrlModes+18)
registersymbol(ctrlChar4)

label(code)
label(return)

newmem:
  push rax
  pushf
  mov rax,rdx
  add rax,rbx
  add rax,08
  cmp [ctrlChar4],0
  jne code
  cmp [ctrlChar1],rax
  je code
  cmp [ctrlChar2],rax
  je code
  cmp [ctrlChar3],rax
  je code
  cmp [ctrlChar4],rax
  je code
  cmp [ctrlChar1],0
  jne @f
  mov [ctrlChar1],rax
  jmp code
  @@:
  cmp [ctrlChar2],0
  jne @f
  mov [ctrlChar2],rax
  jmp code
  @@:
  cmp [ctrlChar3],0
  jne @f
  mov [ctrlChar3],rax
  jmp code
  @@:
  cmp [ctrlChar4],0
  jne @f
  mov [ctrlChar4],rax
code:
  popf
  pop rax
  movbe edx,[rdx+rbx+08]
  mov [rbp+30],rdx
  mov [rbp+00000474],ecx
  jmp return

controlModes:
  jmp newmem
  nop
  nop

return:
registersymbol(controlModes)

