  je code
  cmp [ctrlChar2],rax
  je code
  cmp [ctrlChar3],rax
  je code
  cmp [ctrlChar4],rax
  je code
  cmp [ctrlChar1],0
  jne @f
  mov [ctrlChar1],rax
  jmp code
  @@:
  cmp [ctrlChar2],0
  jne @f
  mov [ctrlChar2],rax
  jmp code
  @@:
  cmp [ctrlChar3],0
  jne @f
  mov [ctrlChar3],rax
  jmp code
  @@:
  cmp [ctrlChar4],0
  jne @f
  mov [ctrlChar4],rax
code:
  popf
  pop rax
  movbe edx,[rdx+rbx+08]
  shl r12,0D
  mov [rbp+30],rdx
  jmp return

controlModes:
  jmp newmem

return:
registersymbol(controlModes)

