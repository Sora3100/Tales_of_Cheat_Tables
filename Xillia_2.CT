<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>82545</ID>
      <Description>"Enable"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

function AOBScanRegion(AOB)
    local ms = createMemScan();
    local flist = createFoundList(ms)

    ms.firstScan(soExactValue, vtByteArray, rtRounded, AOB, "", "300000000", "400000000", "+W-X*C", fsmAligned, "", true, false, false, false)

    ms.waitTillDone()
    flist.initialize()

    return flist
end

function swapEndian(n)
    local b1 = n % 256
    n = (n - b1) / 256
    local b2 = n % 256
    n = (n - b2) / 256
    local b3 = n % 256
    n = (n - b3) / 256
    local b4 = n % 256
    n = (n - b4) / 256

    return b1 * 0x1000000 + b2 * 0x10000 + b3 * 0x100 + b4 * 0x1
end

local AoB = AOBScanRegion("42 54 4C 55 4E 49 54 53 54 41 54 55 53 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 0D 42 54 4C 44 42")

if (AoB.getCount() &gt; 1) then
   print("Something went wrong")
end

local address = AoB[0]
address = tonumber("0x"..address)
address = address + 0x68
address = swapEndian(readInteger(address))
registerSymbol("regionCheckEquip", 0x300000000+address+0x9020C)

AoB.Destroy()
AoB = nil
{$asm}
//aobscanregion(regionCheckEquip, 300000000, 400000000, 42 C8 00 00 42 C8 00 00 42 C8 00 00 42 C8 00 00 42 C8 00 00 42 C8 00 00 42 C8 00 00 42 C8 00 00 42 C8 00 00) // should be unique
aobscanregion(regionCheckFlags, 300000000, 400000000, 46 50 53 5F 53 43 52 5F ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? 00)

//registersymbol(regionCheckEquip)
registersymbol(regionCheckFlags)
[DISABLE]
unregistersymbol(regionCheckEquip)
unregistersymbol(regionCheckFlags)
</AssemblerScript>
