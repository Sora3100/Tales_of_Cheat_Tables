dd 01

ctrlSchemeSaved-3F0+108:
dd 02

ctrlSchemeSaved-3F0+200:
dd 01

ctrlSchemeSaved-3F0+208:
dd 02

ctrlSchemeSaved-3F0+300:
dd 01

ctrlSchemeSaved-3F0+308:
dd 02

[DISABLE]
//English
//Active
ctrlScheme+D0:  //Main 1
dd 02

ctrlScheme+D0+4: //Main 2
dd 01

ctrlScheme+D0+100:
dd 02

ctrlScheme+D0+104:
dd 01

ctrlScheme+D0+200:
dd 02

ctrlScheme+D0+204:
dd 01

ctrlScheme+D0+300:
dd 02

ctrlScheme+D0+304:
dd 01

