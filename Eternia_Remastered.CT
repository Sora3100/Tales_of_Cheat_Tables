[ENABLE]
{$ifndef base_party_formation_original_bytes}
alloc(base_party_formation_original_bytes,$1000)

registersymbol(base_party_formation_original_bytes)
{$endif}

{$ifndef base_party_formation}
aobscanmodule(base_party_formation,GameNative.dll,49 0F BF 00 49 83 C0 02 48 69 C8 D0 00 00 00) // should be unique
alloc(base_party_formation_pointer,$1000,base_party_formation)

label(code)
label(return)

base_party_formation_pointer:
  mov rax,base_party_formation_pointer
  cmp [rax+500],0
  jne code
  mov [rax+500],r8
code:
  movsx rax,word ptr [r8]
  add r8,02
  jmp return

base_party_formation:
  jmp base_party_formation_pointer
  nop 3
return:
registersymbol(base_party_formation base_party_formation_pointer)
{$endif}

{$ifndef base_party_formation_base_2}
aobscanmodule(party_formation_base_2,GameNative.dll,4D 0F BF 8C 43 ** ** ** ** 49 69 C9 D0 00 00 00 66 44 89 4C 24 6C) // should be unique
alloc(newmem2,$1000,party_formation_base_2)

base_party_formation_original_bytes:
  readMem(party_formation_base_2, 9)

label(code2)
label(return2)

newmem2:
  push rax

  mov rax,base_party_formation_pointer
  cmp [rax+500],0
  jne code2

  push rbx
  mov rbx,base_party_formation_original_bytes
  mov ebx,[rbx+5]
  add rbx,r11
  mov [rax+500],rbx
  pop rbx

code2:
  pop rax
  reassemble(party_formation_base_2)
  //movsx r9,word ptr [r11+rax*2+011CAD10]
  jmp return2

party_formation_base_2:
  jmp newmem2
  nop 4
return2:
registersymbol(party_formation_base_2)
{$endif}

{$ifndef tbl_data}
alloc(tbl_data, $1000)

tbl_data: //select character
  dq 1

registersymbol(tbl_data)
{$endif}

[DISABLE]

base_party_formation:
  db 49 0F BF 00 49 83 C0 02

party_formation_base_2:
  readMem(base_party_formation_original_bytes, 9)

unregistersymbol(base_party_formation base_party_formation_pointer tbl_data party_formation_base_2 base_party_formation_original_bytes)
dealloc(base_party_formation_pointer tbl_data newmem2 base_party_formation_original_bytes)

